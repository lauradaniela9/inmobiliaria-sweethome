<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_5_0.xsd"
         version="5.0">

    <display-name>Sweet Home</display-name>

    <!-- Carpeta donde se guardan los documentos radicados por los clientes (fuera del WAR,
         para que sobreviva a un redeploy). Puede sobreescribirse por variable de entorno del
         servidor si se requiere en el despliegue en línea. -->
    <context-param>
        <param-name>upload.dir</param-name>
        <param-value>/tmp/sweethome-uploads</param-value>
    </context-param>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Servlets y Filter también están anotados con @WebServlet / @WebFilter;
         se listan aquí solo como referencia de las rutas del sistema. -->

    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <error-page>
        <error-code>404</error-code>
        <location>/index.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Exception</exception-type>
        <location>/error.jsp</location>
    </error-page>

</web-app>