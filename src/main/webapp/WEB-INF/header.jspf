<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ page import="java.util.List" %>
<%
    // Se calculan banderas simples de rol para el menú (comodidad de interfaz).
    // El control de acceso REAL de cada ruta ocurre siempre en AuthFilter (servidor);
    // esto solo decide qué enlaces mostrar a un usuario que ya está autenticado.
    @SuppressWarnings("unchecked")
    List<String> rolesSesion = (List<String>) session.getAttribute("roles");
    boolean esAdmin = rolesSesion != null && rolesSesion.contains("ADMINISTRADOR");
    boolean esInmobiliaria = rolesSesion != null && rolesSesion.contains("INMOBILIARIA");
    boolean esCliente = rolesSesion != null && rolesSesion.contains("CLIENTE");
    pageContext.setAttribute("esAdmin", esAdmin);
    pageContext.setAttribute("esInmobiliaria", esInmobiliaria);
    pageContext.setAttribute("esCliente", esCliente);
%>
<nav class="navbar navbar-expand-lg navbar-dark navbar-brand-custom mb-4">
    <div class="container">
        <a class="navbar-brand fw-bold" href="<%= request.getContextPath() %>/index.jsp">Sweet Home</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navPrivado">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navPrivado">
            <ul class="navbar-nav me-auto">
                <c:if test="${esAdmin}">
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/admin.jsp">Panel admin</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/admin/usuarios">Usuarios y roles</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/admin/reportes">Reportes</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/admin/auditoria">Auditoría</a></li>
                </c:if>
                <c:if test="${esInmobiliaria}">
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/inmobiliaria.jsp">Panel inmobiliaria</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/inmobiliaria/propiedades">Mis propiedades</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/inmobiliaria/citas">Citas</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/inmobiliaria/solicitudes">Solicitudes</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/inmobiliaria/reportes">Reportes</a></li>
                </c:if>
                <c:if test="${esCliente}">
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/cliente.jsp">Panel cliente</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/catalogo">Buscar propiedades</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/cliente/favoritos">Favoritos</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/cliente/citas">Mis citas</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/cliente/solicitudes">Mis solicitudes</a></li>
                </c:if>
                <li class="nav-item"><a class="nav-link" href="<%= request.getContextPath() %>/dashboard/perfil">Mi perfil</a></li>
            </ul>
            <span class="navbar-text text-white-50 me-3">
                Hola, <%= session.getAttribute("nombres") %> (<%= session.getAttribute("rolPrincipal") %>)
            </span>
            <a class="btn btn-outline-light btn-sm" href="<%= request.getContextPath() %>/logout">Cerrar sesión</a>
        </div>
    </div>
</nav>
